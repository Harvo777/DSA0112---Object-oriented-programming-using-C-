    cout << "STUDENT DETAILS\n";

    {
        Student s("Kavya", 19, 192311001,
                  "Salem", 636001, "CSE");
        s.display();
    }

    cout << "\nCONSTRUCTION ORDER\n";

    {
        Car c;
        cout << "| ";
    }

    cout << "\n";

    return 0;
}
