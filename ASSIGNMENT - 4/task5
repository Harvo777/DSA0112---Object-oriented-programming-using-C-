
#include <iostream>
#include <iomanip>
#include <string>
using namespace std;

class Cart {
    string items[10];
    double prices[10];
    int n = 0;
    double discount = 0;

public:
    Cart& add(string item, double price) {
        if (n < 10) {
            items[n] = item;
            prices[n] = price;
            n++;
        }

        return *this;
    }

    Cart& setDiscount(double discount) {
        this->discount = discount;
        return *this;
    }

    double total() const {
        double t = 0;

        for (int i = 0; i < n; i++) {
            t += prices[i];
        }

        return t * (100 - discount) / 100;
    }

    void display() const {
        for (int i = 0; i < n; i++) {
            cout << items[i] << " : " << prices[i] << endl;
        }
    }
};

int main() {
    // Direct object
    Cart c;

    c.add("Rice", 60)
     .add("Dal", 120)
     .setDiscount(10);

    cout << "Direct object: " << c.total() << endl;

    // Pointer to object
    Cart* p = &c;
    p->add("Oil", 180);

    cout << "Pointer: " << p->total() << endl;

    // Reference to object
    Cart& ref = c;
    cout << "Reference: " << ref.total() << endl;

    // Dynamic object
    Cart* dynamicCart = new Cart();

    dynamicCart->add("Milk", 50);
    cout << "Dynamic object: "
         << dynamicCart->total() << endl;

    delete dynamicCart;

    // Array of pointers
    Cart c1, c2, c3;

    c1.add("Book", 100);
    c2.add("Pen", 50);
    c3.add("Bag", 500);

    Cart* carts[] = {&c1, &c2, &c3};

    int size = 3;
    int highest = 0;

    for (int i = 1; i < size; i++) {
        if (carts[i]->total() > carts[highest]->total()) {
            highest = i;
        }
    }

    cout << "Highest Cart Total: "
         << carts[highest]->total() << endl;

    return 0;
}
