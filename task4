#include <iostream>
using namespace std;

int main() {
    int a = 7, b = 2;
    double c = a / b;
    double d = static_cast<double>(a) / b;
    cout << c << ' ' << d << '\n';

    char ch = 'A' + 2;
    cout << ch << ' ' << ch + 1 << '\n';

    bool flag = 5;
    cout << flag << ' ';
    cout << boolalpha << flag << '\n';

    unsigned int u = 1;
    int s = -1;
    cout << (s < u ? "s < u" : "s >= u") << '\n';

    // Brace initialisation rejects narrowing conversions:
    // int x{3.7}; // Uncommenting this line causes a compile-time error.
    int x = static_cast<int>(3.7);
    cout << "Explicitly converted x = " << x << '\n';
}
