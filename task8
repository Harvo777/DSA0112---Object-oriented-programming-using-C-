#include <iomanip>
#include <iostream>
#include <limits>
using namespace std;

int main() {
    int hour;
    cout << "Enter journey hour (0-23): ";
    while (!(cin >> hour) || hour < 0 || hour > 23) {
        cout << "Invalid input. Enter an integer from 0 to 23: ";
        cin.clear();
        cin.ignore(numeric_limits<streamsize>::max(), '\n');
    }

    long long farePaise = 3000;
    bool peak = (hour >= 8 && hour < 10) || (hour >= 17 && hour < 20);
    if (peak) farePaise += farePaise * 20 / 100;

    cout << fixed << setprecision(2);
    cout << "Peak hour: " << boolalpha << peak << '\n';
    cout << "Fare: Rs " << static_cast<double>(farePaise) / 100.0 << '\n';
}
