#include <iostream>
#include <vector>
#include <variant>
#include <chrono>
#include <stdexcept>
#include <iomanip>
#include <cstdint>
using namespace std;
using Clock = chrono::steady_clock;

struct BillBase {
    virtual ~BillBase() = default;
    virtual double total() const = 0;
};

struct OPVirtual : BillBase {
    double consultation, tests;
    OPVirtual(double c, double t) : consultation(c), tests(t) {}
    double total() const override { return consultation + tests; }
};
struct IPVirtual : BillBase {
    double days, rate, surgery;
    IPVirtual(double d, double r, double s) : days(d), rate(r), surgery(s) {}
    double total() const override { return days * rate + surgery; }
};

struct SwitchBill {
    int type; // 0 = OP, 1 = IP
    double a, b, c;
};
double switchTotal(const SwitchBill& bill) {
    switch (bill.type) {
        case 0: return bill.a + bill.b;
        case 1: return bill.a * bill.b + bill.c;
        default: return 0.0;
    }
}

struct OPVariant { double consultation, tests; };
struct IPVariant { double days, rate, surgery; };
using VariantBill = variant<OPVariant, IPVariant>;
double variantTotal(const VariantBill& b) {
    return visit([](const auto& x) -> double {
        using T = decay_t<decltype(x)>;
        if constexpr (is_same_v<T, OPVariant>) return x.consultation + x.tests;
        else return x.days * x.rate + x.surgery;
    }, b);
}

template<class F>
double measure(const string& label, F fn) {
    auto start = Clock::now();
    volatile double result = fn();
    auto stop = Clock::now();
    auto ms = chrono::duration<double, milli>(stop - start).count();
    cout << left << setw(34) << label << right << setw(12) << fixed
         << setprecision(3) << ms << " ms  checksum=" << result << '\n';
    return ms;
}

int main() {
    cout << "CORRECTNESS TEST (10 BILLS)\n";
    vector<unique_ptr<BillBase>> virtualBills;
    vector<SwitchBill> switchBills;
    vector<VariantBill> variantBills;

    for (int i = 0; i < 10; ++i) {
        if (i % 2 == 0) {
            virtualBills.push_back(make_unique<OPVirtual>(500 + i, 1200));
            switchBills.push_back({0, 500.0 + i, 1200, 0});
            variantBills.push_back(OPVariant{500.0 + i, 1200});
        } else {
            virtualBills.push_back(make_unique<IPVirtual>(3, 2500, 40000 + i));
            switchBills.push_back({1, 3, 2500, 40000.0 + i});
            variantBills.push_back(IPVariant{3, 2500, 40000.0 + i});
        }
    }

    double vSum = 0, sSum = 0, varSum = 0;
    for (const auto& b : virtualBills) vSum += b->total();
    for (const auto& b : switchBills) sSum += switchTotal(b);
    for (const auto& b : variantBills) varSum += variantTotal(b);
    cout << "Virtual total: " << vSum << '\n';
    cout << "Switch total:  " << sSum << '\n';
    cout << "Variant total: " << varSum << "\n\n";

    cout << "TIMING TEST (-O2 recommended)\n";
    for (int n : {1000, 1000000, 10000000}) {
        vector<unique_ptr<BillBase>> vb;
        vector<SwitchBill> sb;
        vb.reserve(n); sb.reserve(n);
        for (int i = 0; i < n; ++i) {
            if (i % 2 == 0) {
                vb.push_back(make_unique<OPVirtual>(500, 1200));
                sb.push_back({0, 500, 1200, 0});
            } else {
                vb.push_back(make_unique<IPVirtual>(3, 2500, 40000));
                sb.push_back({1, 3, 2500, 40000});
            }
        }
        cout << "\nBills: " << n << '\n';
        measure("Virtual function", [&]() {
            double sum = 0;
            for (const auto& b : vb) sum += b->total();
            return sum;
        });
        measure("Switch statement", [&]() {
            double sum = 0;
            for (const auto& b : sb) sum += switchTotal(b);
            return sum;
        });
        if (n == 10000000) {
            vector<VariantBill> vv;
            vv.reserve(n);
            for (int i = 0; i < n; ++i) {
                if (i % 2 == 0) vv.push_back(OPVariant{500, 1200});
                else vv.push_back(IPVariant{3, 2500, 40000});
            }
            measure("std::variant + std::visit", [&]() {
                double sum = 0;
                for (const auto& b : vv) sum += variantTotal(b);
                return sum;
            });
        }
    }

    cout << "\nEXCEPTION VS RETURN-CODE TEST (1,000,000 claims)\n";
    const int N = 1000000;
    for (int invalidPercent : {0, 1, 50}) {
        vector<double> amounts(N, 400.0);
        int invalidCount = N * invalidPercent / 100;
        for (int i = 0; i < invalidCount; ++i) amounts[i] = -1.0;

        measure("Return code " + to_string(invalidPercent) + "% invalid", [&]() {
            long long accepted = 0;
            for (double x : amounts) {
                bool valid = x >= 0;
                if (valid) ++accepted;
            }
            return static_cast<double>(accepted);
        });

        measure("Exceptions " + to_string(invalidPercent) + "% invalid", [&]() {
            long long accepted = 0;
            for (double x : amounts) {
                try {
                    if (x < 0) throw invalid_argument("negative");
                    ++accepted;
                } catch (const invalid_argument&) {
                    // Invalid claim rejected.
                }
            }
            return static_cast<double>(accepted);
        });
    }

    cout << "\nNote: timings depend on CPU, compiler, optimization and system load.\n";
    return 0;
}
