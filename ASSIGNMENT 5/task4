#include <iostream>
#include <iomanip>
#include <memory>
#include <string>
#include <vector>
#include <algorithm>
#include <stdexcept>
using namespace std;

// Existing polymorphic interface
class Bill {
protected:
    string patient;
public:
    explicit Bill(const string& p) : patient(p) {}
    virtual ~Bill() = default;
    virtual double total() const = 0;
    virtual string type() const = 0;
    const string& patientName() const { return patient; }
};

class OutPatientBill : public Bill {
    double consultation, tests;
public:
    OutPatientBill(const string& p, double c, double t)
        : Bill(p), consultation(c), tests(t) {
        if (c < 0 || t < 0) throw invalid_argument("negative OP charge");
    }
    double total() const override { return consultation + tests; }
    string type() const override { return "OP"; }
};

class InPatientBill : public Bill {
    int days;
    double perDay, surgery;
public:
    InPatientBill(const string& p, int d, double rate, double s)
        : Bill(p), days(d), perDay(rate), surgery(s) {
        if (d < 0 || rate < 0 || s < 0) throw invalid_argument("negative IP charge");
    }
    double total() const override { return days * perDay + surgery; }
    string type() const override { return "IP"; }
};

// New bill type added by extension. Existing classes are unchanged.
class TelemedicineBill : public Bill {
    double consultationFee, platformFee;
public:
    TelemedicineBill(const string& p, double consultation, double platform)
        : Bill(p), consultationFee(consultation), platformFee(platform) {
        if (consultation < 0 || platform < 0)
            throw invalid_argument("negative telemedicine charge");
    }
    double total() const override { return consultationFee + platformFee; }
    string type() const override { return "TELEMEDICINE"; }
};

// Existing payer interface
class Payer {
public:
    virtual ~Payer() = default;
    virtual double amountCovered(const Bill& bill) const = 0;
    virtual string name() const = 0;
};

class SelfPay : public Payer {
public:
    double amountCovered(const Bill&) const override { return 0; }
    string name() const override { return "SelfPay"; }
};

class Insurance : public Payer {
    double limit;
    double copayPercent;
public:
    Insurance(double l, double c) : limit(l), copayPercent(c) {
        if (l < 0 || c < 0 || c > 100) throw invalid_argument("invalid policy");
    }
    double amountCovered(const Bill& b) const override {
        return min(b.total(), limit) * (100 - copayPercent) / 100.0;
    }
    string name() const override { return "Insurance"; }
};

// New payer added without changing the existing payer classes.
class CorporateTieUp : public Payer {
    double coveragePercent;
    double maximum;
public:
    CorporateTieUp(double percent, double maxAmount)
        : coveragePercent(percent), maximum(maxAmount) {
        if (percent < 0 || percent > 100 || maxAmount < 0)
            throw invalid_argument("invalid corporate policy");
    }
    double amountCovered(const Bill& b) const override {
        return min(b.total() * coveragePercent / 100.0, maximum);
    }
    string name() const override { return "CorporateTieUp"; }
};

int main() {
    try {
        vector<unique_ptr<Bill>> bills;
        bills.push_back(make_unique<OutPatientBill>("Ravi", 500, 1200));
        bills.push_back(make_unique<InPatientBill>("Meena", 3, 2500, 40000));
        bills.push_back(make_unique<TelemedicineBill>("Kiran", 800, 100));

        CorporateTieUp corporate(80, 30000);
        Insurance insurance(50000, 20);
        vector<const Payer*> payers = {&insurance, &corporate};

        cout << fixed << setprecision(2);
        cout << "EXTENDED BILLING SYSTEM\n";
        for (const auto& bill : bills) {
            cout << bill->type() << " " << bill->patientName()
                 << " total = " << bill->total() << '\n';
            for (const Payer* payer : payers) {
                double covered = payer->amountCovered(*bill);
                cout << "  " << payer->name() << " covers " << covered
                     << ", patient pays " << bill->total() - covered << '\n';
            }
        }

        cout << "\nAll earlier bill and payer classes remain unchanged.\n";
        cout << "Run with -fsanitize=address to check memory safety.\n";
    } catch (const exception& e) {
        cerr << "Billing error: " << e.what() << '\n';
        return 1;
    }
    return 0;
}
