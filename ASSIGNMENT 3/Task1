#include <iostream>
#include <string>
#include <stdexcept>

class Book {
    std::string title;
    std::string author;
    int copies;

    static int validCopies(int value) {
        if (value < 0) throw std::invalid_argument("Copies cannot be negative");
        return value;
    }

public:
    Book() : Book("Untitled", "Unknown", 0) {}
    explicit Book(const std::string& t) : Book(t, "Unknown", 0) {}
    Book(const std::string& t, const std::string& a, int c)
        : title(t), author(a), copies(validCopies(c)) {}

    void display() const {
        std::cout << "Title: " << title << ", Author: " << author
                  << ", Copies: " << copies << '\n';
    }
};

int main() {
    try {
        Book empty;
        Book donated("The Alchemist");
        Book full("Wings of Fire", "A.P.J. Abdul Kalam", 5);

        empty.display();
        donated.display();
        full.display();

        // Uncomment to test invalid input:
        // Book invalid("Test", "Author", -2);
    } catch (const std::exception& e) {
        std::cout << "Error: " << e.what() << '\n';
    }
    return 0;
}
