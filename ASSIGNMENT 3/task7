#include <cmath>
#include <iostream>
#include <stdexcept>

class Complex {
    double real;
    double imag;

public:
    Complex() : real(0), imag(0) {}
    Complex(double r) : real(r), imag(0) {}
    Complex(double r, double i) : real(r), imag(i) {}

    Complex operator+(const Complex& z) const {
        return Complex(real + z.real, imag + z.imag);
    }

    Complex operator-(const Complex& z) const {
        return Complex(real - z.real, imag - z.imag);
    }

    Complex operator*(const Complex& z) const {
        return Complex(real * z.real - imag * z.imag,
                       real * z.imag + imag * z.real);
    }

    Complex operator/(const Complex& z) const {
        double denominator = z.real * z.real + z.imag * z.imag;
        if (denominator == 0.0)
            throw std::runtime_error("Division by zero impedance");
        return Complex((real * z.real + imag * z.imag) / denominator,
                       (imag * z.real - real * z.imag) / denominator);
    }

    bool operator==(const Complex& z) const {
        const double eps = 1e-9;
        return std::abs(real - z.real) < eps &&
               std::abs(imag - z.imag) < eps;
    }

    double magnitude() const { return std::sqrt(real * real + imag * imag); }

    friend std::ostream& operator<<(std::ostream& os, const Complex& z) {
        os << z.real;
        if (z.imag >= 0) os << " + j" << z.imag;
        else os << " - j" << -z.imag;
        return os;
    }
};

int main() {
    const double pi = std::acos(-1.0);
    const double frequency = 50.0;
    const double omega = 2.0 * pi * frequency;
    const double inductance = 0.1;
    const double capacitance = 100e-6;

    Complex resistor(100.0, 0.0);
    Complex inductor(0.0, omega * inductance);
    Complex capacitor(0.0, -1.0 / (omega * capacitance));

    Complex series = resistor + inductor + capacitor;
    std::cout << "Series impedance: " << series << '\n';
    std::cout << "Series magnitude: " << series.magnitude() << " ohms\n";

    Complex z1(100.0, 20.0);
    Complex z2(50.0, -10.0);
    Complex parallel = (z1 * z2) / (z1 + z2);
    std::cout << "Parallel impedance: " << parallel << '\n';
    std::cout << "Parallel magnitude: " << parallel.magnitude() << " ohms\n";

    try {
        Complex zero;
        Complex invalid = z1 / zero;
        std::cout << invalid << '\n';
    } catch (const std::exception& e) {
        std::cout << "Error: " << e.what() << '\n';
    }
    return 0;
}
