#include <iomanip>
#include <iostream>

class Money {
    long long paise;

public:
    Money(long long rupees = 0, int p = 0)
        : paise(rupees * 100 + p) {}

    Money operator+(const Money& other) const {
        Money result;
        result.paise = paise + other.paise;
        return result;
    }

    Money& operator+=(const Money& other) {
        paise += other.paise;
        return *this;
    }

    bool operator==(const Money& other) const {
        return paise == other.paise;
    }

    bool operator<(const Money& other) const {
        return paise < other.paise;
    }

    friend std::ostream& operator<<(std::ostream& os, const Money& amount) {
        long long absolute = amount.paise < 0 ? -amount.paise : amount.paise;
        if (amount.paise < 0) os << "-";
        os << "Rs " << absolute / 100 << '.'
           << std::setw(2) << std::setfill('0') << absolute % 100
           << std::setfill(' ');
        return os;
    }

    friend std::istream& operator>>(std::istream& is, Money& amount) {
        long long rupees;
        int p;
        if (is >> rupees >> p) amount.paise = rupees * 100 + p;
        return is;
    }
};

int main() {
    Money a(120, 75), b(79, 25);
    Money c = a + b;
    std::cout << c << '\n' << std::boolalpha << (c == Money(200)) << '\n';

    Money x(0, 75), y(0, 50);
    std::cout << x + y << '\n'; // Rs 1.25
    return 0;
}
