#include <cstring>
#include <iostream>

class Text {
    char* data;

public:
    Text(const char* value = "") {
        if (!value) value = "";
        data = new char[std::strlen(value) + 1];
        std::strcpy(data, value);
    }

    Text(const Text& other) {
        data = new char[std::strlen(other.data) + 1];
        std::strcpy(data, other.data);
    }

    Text& operator=(const Text& other) {
        if (this == &other) return *this;
        char* fresh = new char[std::strlen(other.data) + 1];
        std::strcpy(fresh, other.data);
        delete[] data;
        data = fresh;
        return *this;
    }

    ~Text() { delete[] data; }

    Text operator+(const Text& other) const {
        std::size_t len = std::strlen(data) + std::strlen(other.data);
        char* buffer = new char[len + 1];
        std::strcpy(buffer, data);
        std::strcat(buffer, other.data);
        Text result(buffer);
        delete[] buffer;
        return result;
    }

    bool operator==(const Text& other) const {
        return std::strcmp(data, other.data) == 0;
    }

    bool operator!=(const Text& other) const {
        return !(*this == other);
    }

    friend std::ostream& operator<<(std::ostream& os, const Text& text) {
        return os << text.data;
    }
};

int main() {
    Text first("Hello ");
    Text second("World");
    Text third = first + second;

    std::cout << third << '\n';
    std::cout << std::boolalpha << (third == Text("Hello World")) << '\n';

    third = third; // self-assignment
    Text empty;
    std::cout << "Empty text: [" << empty << "]\n";

    Text longMessage("This is a longer message used to test dynamic memory.");
    Text copy = longMessage;
    std::cout << copy << '\n';
    return 0;
}
