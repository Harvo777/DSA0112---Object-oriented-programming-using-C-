#include <array>
#include <iostream>
#include <set>
using namespace std;

enum class Zone { Inner, Middle, Outer, Airport };

constexpr array<long long, 4> FARE_PAISE = {1000, 2000, 3000, 6000};

class MonthlyPass {
private:
    set<Zone> coveredZones;
public:
    MonthlyPass(Zone first, Zone second) {
        coveredZones.insert(first);
        coveredZones.insert(second);
    }
    bool covers(Zone zone) const {
        return coveredZones.count(zone) > 0;
    }
};

long long calculateFare(Zone zone, int hour, bool weekend,
                        const MonthlyPass* pass) {
    if (pass != nullptr && pass->covers(zone)) return 0;

    long long amount = FARE_PAISE.at(static_cast<size_t>(zone));
    bool peak = (hour >= 8 && hour < 10) || (hour >= 17 && hour < 20);

    // Weekend discount does not combine with peak surcharge.
    if (weekend) {
        amount = amount * 90 / 100;
    } else if (peak) {
        amount += amount * 20 / 100;
    }
    return amount;
}

int main() {
    MonthlyPass pass(Zone::Inner, Zone::Middle);

    cout << "Airport weekday peak fare (paise): "
         << calculateFare(Zone::Airport, 18, false, nullptr) << '\n';
    cout << "Airport weekend fare (paise): "
         << calculateFare(Zone::Airport, 18, true, nullptr) << '\n';
    cout << "Inner zone with monthly pass (paise): "
         << calculateFare(Zone::Inner, 9, false, &pass) << '\n';
    cout << "Outer weekday peak fare (paise): "
         << calculateFare(Zone::Outer, 18, false, &pass) << '\n';
}
